---
import { ArrowUpRight } from 'lucide-react';

// 사이트 밖으로 나가는 링크(새 탭 + ↗ + 화면 읽기용 "(새 탭)")
interface Props {
  href: string;
  prefetch?: boolean;
}
const { href, prefetch = true } = Astro.props;
---

<a href={href} target="_blank" rel="noopener" data-astro-prefetch={prefetch ? undefined : 'false'}><slot /><ArrowUpRight size={13} className="ext" aria-hidden="true" /><span class="sr-only">(새 탭)</span></a>
